# ============================================
# App
# ============================================
# Site URL (used for canonical URLs, sitemap, etc.)
NEXT_PUBLIC_SITE_URL=https://801outlet.com

# Phone contact (E.164 format)
NEXT_PUBLIC_PHONE_E164=+13852016328

# ============================================
# Maintenance gate
# ============================================
# 1/true/on serves the maintenance page with HTTP 503 on every public route.
# Read at build time — flipping it requires a redeploy.
MAINTENANCE_MODE=
# Random secret; ?preview=<token> unlocks the real site while gated.
MAINTENANCE_BYPASS_TOKEN=

# ============================================
# Shopify Headless (new commerce source of truth)
# ============================================
SHOPIFY_STORE_DOMAIN=801-outlet.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-07
# Server-side only — generated by the Shopify Headless channel
SHOPIFY_STOREFRONT_PRIVATE_ACCESS_TOKEN=

# Customer Account API — values provided by the Headless channel settings
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_API_URL=
SHOPIFY_CUSTOMER_ACCOUNT_AUTH_URL=
SHOPIFY_CUSTOMER_ACCOUNT_TOKEN_URL=
SHOPIFY_CUSTOMER_ACCOUNT_CALLBACK_URL=http://localhost:3000/account/authorize

# Used to authenticate Shopify webhook-triggered cache revalidation
SHOPIFY_REVALIDATION_SECRET=

# ============================================
# Legacy Database / Auth (Supabase — do not expand)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# Legacy Payments (Square — replaced by Shopify checkout)
# ============================================
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=

# ============================================
# Email (Resend)
# ============================================
RESEND_API_KEY=
EMAIL_FROM=orders@801outlet.com

# ============================================
# Admin
# ============================================
# Comma-separated list of admin emails
ADMIN_ALLOWED_EMAILS=

# ============================================
# Google Drive photo picker (panel)
# ============================================
# All three are required together; without them the "Choose from Drive"
# button does not render. Public by nature — protected by the origin
# restriction on the key, not by secrecy. Inlined at build time.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
# Cloud project NUMBER, not the project id — required by the picker's setAppId
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=

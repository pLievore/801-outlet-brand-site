{
  "name": "801-outlet-brand-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "graphql-codegen": "graphql-codegen",
    "shopify:check": "tsx --conditions=react-server --env-file=.env.local scripts/check-shopify.ts",
    "test": "npm run test:shopify && npm run test:design",
    "test:shopify": "tsx --test src/lib/format.test.ts src/lib/catalog/filters.test.ts src/lib/catalog/availability.test.ts src/lib/catalog/attributes.test.ts src/lib/analytics/funnel.test.ts src/lib/analytics/attribution.test.ts src/lib/shopify/config-schema.test.ts src/lib/shopify/errors.test.ts src/lib/shopify/adapters/menu.test.ts src/lib/shopify/adapters/products.test.ts src/lib/shopify/revalidation.test.ts src/lib/shopify/adapters/cart.test.ts src/lib/shopify/customer/pkce.test.ts",
    "db:seed": "tsx --env-file=.env.local db/seed.ts",
    "test:design": "tsx --test src/lib/design/contrast.test.ts src/lib/content/booking.test.ts src/lib/content/ics.test.ts",
    "panel:token": "tsx --env-file=.env.local scripts/get-panel-token.ts",
    "shipping:rates": "tsx --env-file=.env.local scripts/shipping-rates.ts",
    "shipping:required": "tsx --env-file=.env.local scripts/requires-shipping.ts",
    "metafields:setup": "tsx --env-file=.env.local scripts/setup-product-metafields.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@shopify/storefront-api-client": "^1.0.10",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/analytics": "^1.6.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.27.1",
    "lucide-react": "^0.562.0",
    "next": "16.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.75.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "square": "^44.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^2.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
